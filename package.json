{
  "name": "trustos-learn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces --if-present",
    "start": "npm run start --workspace @trustos-learn/api",
    "typecheck": "npm run typecheck --workspaces"
  }
}
